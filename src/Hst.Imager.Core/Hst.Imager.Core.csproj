<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <PackageReference Include="Hst.Amiga" Version="0.6.238" />
      <PackageReference Include="hst.compression" Version="0.4.91" />
      <PackageReference Include="Hst.Core" Version="0.4.91" />
      <PackageReference Include="LTRData.DiscUtils.Containers" Version="1.0.89" />
      <PackageReference Include="LTRData.DiscUtils.ExFat" Version="1.0.89" />
      <PackageReference Include="LTRData.DiscUtils.Fat" Version="1.0.89" />
      <PackageReference Include="LTRData.DiscUtils.FileSystems" Version="1.0.89" />
      <PackageReference Include="LTRData.DiscUtils.Vhd" Version="1.0.89" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
      <PackageReference Include="plist-cil" Version="2.3.1" />
      <PackageReference Include="SharpCompress" Version="0.50.5" />
      <PackageReference Include="SharpZipLib" Version="1.4.2" />
      <!-- Override vulnerable transitive version from Hst.Core -> Microsoft.Windows.Compatibility -->
      <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Data\guid-partition-types.csv" />
      <EmbeddedResource Include="Data\guid-partition-types.csv" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Compressions\Xz\" />
      <Folder Include="Properties\" />
    </ItemGroup>

    <PropertyGroup>
        <IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</IsWindows>
        <IsOSX Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsOSX>
        <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IsWindows)'=='true'">
        <DefineConstants>Windows</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IsOSX)'=='true'">
        <DefineConstants>OSX</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IsLinux)'=='true'">
        <DefineConstants>Linux</DefineConstants>
    </PropertyGroup>    
</Project>

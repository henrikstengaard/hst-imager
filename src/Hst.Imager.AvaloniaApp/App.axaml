<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hst.Imager.AvaloniaApp.App"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:controls="using:Hst.Imager.AvaloniaApp.Controls"
             RequestedThemeVariant="Default">

  <!-- Color mode brushes, default variant follows operating system light or dark mode -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#1A2933" />
          <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#0F1E28" />
          <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#AAAAAA" />
          <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#2D3F4C" />
          <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#243340" />
          <SolidColorBrush x:Key="AppStrongForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppBodyForegroundBrush" Color="#CCCCCC" />
          <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#AAAAAA" />
          <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#999999" />
          <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#243340" />
          <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#0D1F2A" />
          <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#1E2D38" />
          <SolidColorBrush x:Key="AppOverlayBackgroundBrush" Color="#CC1A2933" />
          <SolidColorBrush x:Key="AppErrorBackgroundBrush" Color="#4A1A1A" />
          <SolidColorBrush x:Key="AppErrorForegroundBrush" Color="#FF6B6B" />
          <SolidColorBrush x:Key="AppWarningBackgroundBrush" Color="#3A2800" />
          <SolidColorBrush x:Key="AppWarningForegroundBrush" Color="#FFBB33" />
          <SolidColorBrush x:Key="AppSuccessForegroundBrush" Color="#33CC33" />
          <SolidColorBrush x:Key="AppFailureForegroundBrush" Color="#CC3333" />
          <SolidColorBrush x:Key="AppLinkForegroundBrush" Color="#66B3FF" />
          <SolidColorBrush x:Key="AppLinkHoverForegroundBrush" Color="#99CCFF" />
          <SolidColorBrush x:Key="AppDividerBrush" Color="#2D3F4C" />
          <SolidColorBrush x:Key="AppActionBarBackgroundBrush" Color="#0F1E28" />
          <SolidColorBrush x:Key="AppPrimaryBackgroundBrush" Color="#2F80D0" />
          <SolidColorBrush x:Key="AppPrimaryHoverBackgroundBrush" Color="#4A94DC" />
          <SolidColorBrush x:Key="AppPrimaryPressedBackgroundBrush" Color="#276DB2" />
          <SolidColorBrush x:Key="AppDangerBackgroundBrush" Color="#C62828" />
          <SolidColorBrush x:Key="AppDangerHoverBackgroundBrush" Color="#D84343" />
          <SolidColorBrush x:Key="AppDangerPressedBackgroundBrush" Color="#A82222" />
          <SolidColorBrush x:Key="AppOnColorForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F3F5F7" />
          <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#DDE3E8" />
          <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#5A6670" />
          <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#C8D1D8" />
          <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#F3F5F7" />
          <SolidColorBrush x:Key="AppStrongForegroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="AppBodyForegroundBrush" Color="#333333" />
          <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#555555" />
          <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#666666" />
          <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppOverlayBackgroundBrush" Color="#CCF3F5F7" />
          <SolidColorBrush x:Key="AppErrorBackgroundBrush" Color="#FDE2E2" />
          <SolidColorBrush x:Key="AppErrorForegroundBrush" Color="#B71C1C" />
          <SolidColorBrush x:Key="AppWarningBackgroundBrush" Color="#FFF4D6" />
          <SolidColorBrush x:Key="AppWarningForegroundBrush" Color="#8A5A00" />
          <SolidColorBrush x:Key="AppSuccessForegroundBrush" Color="#2E7D32" />
          <SolidColorBrush x:Key="AppFailureForegroundBrush" Color="#C62828" />
          <SolidColorBrush x:Key="AppLinkForegroundBrush" Color="#0063B1" />
          <SolidColorBrush x:Key="AppLinkHoverForegroundBrush" Color="#004A85" />
          <SolidColorBrush x:Key="AppDividerBrush" Color="#C8D1D8" />
          <SolidColorBrush x:Key="AppActionBarBackgroundBrush" Color="#E8ECEF" />
          <SolidColorBrush x:Key="AppPrimaryBackgroundBrush" Color="#1F6FBF" />
          <SolidColorBrush x:Key="AppPrimaryHoverBackgroundBrush" Color="#2B7FD3" />
          <SolidColorBrush x:Key="AppPrimaryPressedBackgroundBrush" Color="#195C9E" />
          <SolidColorBrush x:Key="AppDangerBackgroundBrush" Color="#C62828" />
          <SolidColorBrush x:Key="AppDangerHoverBackgroundBrush" Color="#D63B3B" />
          <SolidColorBrush x:Key="AppDangerPressedBackgroundBrush" Color="#A82222" />
          <SolidColorBrush x:Key="AppOnColorForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Page layout with fixed header, scrollable full width content and fixed action bar -->
      <ControlTheme x:Key="{x:Type controls:PageLayout}" TargetType="controls:PageLayout">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Grid.Row="0" Margin="16,16,16,0"
                          IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="page-title" Text="{TemplateBinding Title}" />
                <TextBlock Classes="page-description" Text="{TemplateBinding Description}" TextWrapping="Wrap"
                           IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <ScrollViewer Grid.Row="1">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="16,0,20,16" />
              </ScrollViewer>
              <Border Grid.Row="2" Classes="action-bar"
                      IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding Actions}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}" />
    </Style>

    <Style Selector="Border.sidebar">
      <Setter Property="Width" Value="200" />
    </Style>
    <Style Selector="Border.sidebar.collapsed">
      <Setter Property="Width" Value="62" />
    </Style>

    <Style Selector="Button.nav-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppNavForegroundBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNavHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppNavActiveForegroundBrush}" />
    </Style>
    <Style Selector="Button.nav-item.active">
      <Setter Property="Foreground" Value="{DynamicResource AppNavActiveForegroundBrush}" />
    </Style>
    <Style Selector="Button.nav-item.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNavActiveBackgroundBrush}" />
    </Style>
    <Style Selector="Button.nav-item.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNavHoverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.nav-indicator">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style Selector="TextBlock.nav-label">
      <Setter Property="Margin" Value="14,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppStrongForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.page-description">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AppSecondaryForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="TextBlock.error-text">
      <Setter Property="Foreground" Value="{DynamicResource AppErrorForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.progress-overlay">
      <Setter Property="Background" Value="{DynamicResource AppOverlayBackgroundBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Selected source or destination media, which is clicked to change it -->
    <Style Selector="Button.media-card">
      <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.media-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNavHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBackgroundBrush}" />
    </Style>
    <Style Selector="Button.media-card TextBlock.placeholder">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource AppBodyForegroundBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.field-help">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ia|Icon.field-icon">
      <Setter Property="Foreground" Value="{DynamicResource AppBodyForegroundBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppStrongForegroundBrush}" />
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <Style Selector="Border.warning">
      <Setter Property="Background" Value="{DynamicResource AppWarningBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.warning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppWarningForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppLinkForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppLinkHoverForegroundBrush}" />
    </Style>

    <Style Selector="Border.action-bar">
      <Setter Property="Background" Value="{DynamicResource AppActionBarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="16,10,20,10" />
    </Style>
    <Style Selector="Border.action-bar Button">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Primary action button, e.g. start read -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnColorForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnColorForegroundBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryPressedBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnColorForegroundBrush}" />
    </Style>

    <!-- Destructive action button overwriting data, e.g. start write -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource AppDangerBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnColorForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppDangerHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnColorForegroundBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppDangerPressedBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnColorForegroundBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
    </Style>
  </Application.Styles>

</Application>

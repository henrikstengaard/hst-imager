<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             x:Class="Hst.Imager.AvaloniaApp.Views.FormatView"
             x:DataType="vm:FormatViewModel">

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="12" Margin="0,8">
        <TextBlock Classes="page-title" Text="Format" />
        <TextBlock Classes="page-description" Text="Formats a disk or image with a partition table and filesystem." />

        <Border Background="#4A1A1A" CornerRadius="4" Padding="8" IsVisible="{Binding HasError}">
          <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Target: disk or image -->
        <TextBlock Text="Target disk or image file" Foreground="#AAAAAA" FontSize="12" />
        <CheckBox Content="Use image file instead of physical disk" IsChecked="{Binding UseCustomPath}" />

        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding UseCustomPath}">
          <TextBox Grid.Column="0" Text="{Binding CustomPath}" Watermark="Path to image file..." />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowsePathCommand}">...</Button>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !UseCustomPath}">
          <ComboBox Grid.Column="0" ItemsSource="{Binding MediaItems}" SelectedItem="{Binding SelectedMedia}"
                    DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshMediaCommand}">&#8635;</Button>
        </Grid>

        <!-- Partition table type -->
        <TextBlock Text="Partition table type" Foreground="#AAAAAA" FontSize="12" />
        <ComboBox ItemsSource="{Binding FormatTypeOptions}"
                  SelectedItem="{Binding SelectedFormatType}"
                  DisplayMemberBinding="{Binding Title}"
                  HorizontalAlignment="Stretch" />

        <!-- File system -->
        <TextBlock Text="File system" Foreground="#AAAAAA" FontSize="12" />
        <ComboBox ItemsSource="{Binding FileSystemOptions}"
                  SelectedItem="{Binding SelectedFileSystem}"
                  HorizontalAlignment="Stretch" />

        <Expander Header="Advanced options" IsExpanded="False">
          <StackPanel Spacing="8" Margin="0,8">
            <TextBlock Text="Size (bytes, 0 = full disk)" Foreground="#AAAAAA" FontSize="12" />
            <NumericUpDown Value="{Binding Size}" Minimum="0" Increment="1048576" />
            <TextBlock Text="Max partition size (bytes, 0 = no limit)" Foreground="#AAAAAA" FontSize="12" />
            <NumericUpDown Value="{Binding MaxPartitionSize}" Minimum="0" Increment="1048576" />
            <CheckBox Content="Use experimental features" IsChecked="{Binding UseExperimental}" />
            <CheckBox Content="Kickstart 3.1 compatible" IsChecked="{Binding Kickstart31}" />
            <CheckBox Content="Byteswap" IsChecked="{Binding Byteswap}" />
          </StackPanel>
        </Expander>

        <Border IsVisible="{Binding Progress.IsRunning}" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Progress.Title}" Foreground="White" FontWeight="SemiBold" />
            <ProgressBar Value="{Binding Progress.PercentComplete}" Minimum="0" Maximum="100" Height="8" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{Binding Progress.BytesText}" Foreground="#AAAAAA" FontSize="12" />
              <TextBlock Text="{Binding Progress.SpeedText}" Foreground="#AAAAAA" FontSize="12" />
            </StackPanel>
            <TextBlock Classes="error-text" Text="{Binding Progress.ErrorMessage}" IsVisible="{Binding Progress.HasError}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Command="{Binding CancelCommand}" IsVisible="{Binding Progress.IsRunning}">Cancel</Button>
      <Button Command="{Binding StartFormatCommand}" IsVisible="{Binding !Progress.IsRunning}" Classes="accent">Start Format</Button>
    </StackPanel>
  </Grid>
</UserControl>

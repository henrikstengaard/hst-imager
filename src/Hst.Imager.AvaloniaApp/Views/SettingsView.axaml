<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             x:Class="Hst.Imager.AvaloniaApp.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="8" Margin="0,8" MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Classes="page-title" Text="Settings" />
      <TextBlock Classes="page-description" Text="Configure settings for read, write, and debug." />

      <CheckBox Content="Show all physical drives (except system/boot drives)"
                IsChecked="{Binding AllPhysicalDrives}" />

      <Border Classes="warning" IsVisible="{Binding AllPhysicalDrives}">
        <TextBlock TextWrapping="Wrap"
                   Text="All physical drive shown enables Hst Imager to read and write all disks except system and boot drives. Be very sure to select the correct physical drive when this is enabled otherwise Hst Imager might destroy your disk and it's file system!" />
      </Border>

      <TextBlock Classes="field-label" Text="macOS elevate method" Margin="0,8,0,0" />
      <ComboBox ItemsSource="{Binding MacOsElevateMethodOptions}"
                SelectedItem="{Binding MacOsElevateMethod}"
                DisplayMemberBinding="{Binding Title}"
                IsEnabled="{Binding IsMacOs}"
                HorizontalAlignment="Stretch" />

      <TextBlock Classes="section-title" Text="Read and write" />

      <TextBlock Classes="field-label" Text="Retries" />
      <NumericUpDown Value="{Binding Retries}" Minimum="0" Maximum="100" FormatString="0"
                     Width="140" HorizontalAlignment="Left" />

      <CheckBox Content="Force and ignore errors when retries are exceeded"
                IsChecked="{Binding Force}" />

      <CheckBox Content="Verify while reading and writing"
                IsChecked="{Binding Verify}" />

      <CheckBox Content="Skip unused sectors"
                IsChecked="{Binding SkipUnusedSectors}" />

      <Border Classes="warning" IsVisible="{Binding SkipUnusedSectors}">
        <TextBlock TextWrapping="Wrap"
                   Text="Skip unused sectors will make writing and comparing images much faster as sectors with only zeroes are skipped. It also means skipped sectors may contain old data that would otherwise be erased with zeroes and not all operating systems or file systems support this. As an example ChromeOS images will not be able to recover properly if unused sectors are skipped!" />
      </Border>

      <CheckBox Content="Sparse files"
                IsChecked="{Binding SparseFiles}" />

      <TextBlock Classes="section-title" Text="Debug" />

      <CheckBox Content="Debug mode (applied after restart of app)"
                IsChecked="{Binding DebugMode}"
                IsEnabled="{Binding IsDebugModeEnabled}" />

      <Button Command="{Binding ViewLogsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ia:Icon Value="fa-chart-line" />
          <TextBlock Text="View logs" />
        </StackPanel>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
        xmlns:ia="clr-namespace:Optris.Icons.Avalonia;assembly=Optris.Icons.Avalonia"
        xmlns:controls="using:Hst.Imager.AvaloniaApp.Controls"
        x:Class="Hst.Imager.AvaloniaApp.Views.PartitionDialog"
        x:DataType="vm:PartitionViewModel"
        Title="Partition"
        Width="720"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">

  <!-- details of selected partition, which are edited directly as pending operations -->
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="{Binding SelectedPartitionTitle}" FontSize="18" FontWeight="SemiBold" />

    <StackPanel Spacing="4" IsVisible="{Binding IsExistingPartitionSelected}">
      <CheckBox Content="Format partition, which erases all data on it"
                IsChecked="{Binding SelectedPartition.FormatRequested, FallbackValue=False}" />
      <TextBlock Classes="field-help" TextWrapping="Wrap"
                 Text="Existing partitions can't be moved or resized. Delete the partition to use its space for new partitions." />
    </StackPanel>

    <controls:ResponsiveColumns MaxColumns="3" MinColumnWidth="220">
      <!-- Partition type of new partition: bios type, partition type guid or dos type -->
      <StackPanel Spacing="4" IsVisible="{Binding SelectedPartition.CanEditPartitionType, FallbackValue=False}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-shapes" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="{Binding SelectedPartition.PartitionTypeLabel, FallbackValue=''}" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding SelectedPartition.PartitionTypeOptions, FallbackValue={x:Null}}"
                  SelectedItem="{Binding SelectedPartition.PartitionTypeOption, FallbackValue={x:Null}}"
                  DisplayMemberBinding="{Binding Title}"
                  HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Partition type entered manually -->
      <StackPanel Spacing="4" IsVisible="{Binding SelectedPartition.IsCustomPartitionType, FallbackValue=False}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-keyboard" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="{Binding SelectedPartition.CustomPartitionTypeLabel, FallbackValue=''}" />
        </StackPanel>
        <TextBox
                 Text="{Binding SelectedPartition.CustomPartitionType, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </controls:ResponsiveColumns>

    <controls:ResponsiveColumns MaxColumns="3" MinColumnWidth="220">
      <!-- File system -->
      <StackPanel Spacing="4" IsVisible="{Binding SelectedPartition.ShowFileSystem, FallbackValue=True}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-sliders" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="File system" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding SelectedPartition.FileSystemOptions, FallbackValue={x:Null}}"
                  SelectedItem="{Binding SelectedPartition.FileSystemOption, FallbackValue={x:Null}}"
                  DisplayMemberBinding="{Binding Title}"
                  IsEnabled="{Binding SelectedPartition.CanEditFileSystem, FallbackValue=False}"
                  PlaceholderText="{Binding SelectedPartition.ExistingFileSystem, FallbackValue=''}"
                  HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Device name -->
      <StackPanel Spacing="4" IsVisible="{Binding IsRdb}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-hdd" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Device name" />
        </StackPanel>
        <TextBox Text="{Binding SelectedPartition.DeviceName, FallbackValue=''}"
                 IsEnabled="{Binding SelectedPartition.CanEditRdbProperties, FallbackValue=False}" />
      </StackPanel>

      <!-- Volume name -->
      <StackPanel Spacing="4" IsVisible="{Binding SelectedPartition.CanEditLabel, FallbackValue=True}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-tag" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Volume name" />
        </StackPanel>
        <TextBox Text="{Binding SelectedPartition.Label, FallbackValue=''}"
                 IsEnabled="{Binding SelectedPartition.CanEditLabel, FallbackValue=False}" />
      </StackPanel>
    </controls:ResponsiveColumns>

    <TextBlock Classes="error-text" TextWrapping="Wrap"
               IsVisible="{Binding SelectedPartition.HasDialogError, FallbackValue=False}"
               Text="{Binding SelectedPartition.DialogError, FallbackValue=''}" />

    <!-- File system in rigid disk block used by new rigid disk block partition, which can be imported -->
    <StackPanel Spacing="6" IsVisible="{Binding ShowRdbFileSystem}">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <ia:Icon Value="fa-puzzle-piece" Classes="field-icon" />
        <TextBlock Classes="field-label" Text="File system in Rigid Disk Block" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ia:Icon Value="fa-triangle-exclamation" IsVisible="{Binding IsRdbFileSystemMissing}"
                 Foreground="{DynamicResource AppWarningForegroundBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Classes="field-help" TextWrapping="Wrap" MaxWidth="640" Text="{Binding RdbFileSystemText}" />
      </StackPanel>
      <StackPanel Spacing="4" IsVisible="{Binding IsImportedFileSystemFromMedia}">
        <TextBlock Classes="field-label" Text="Name of file system to find in media" />
        <TextBox Text="{Binding SelectedPartitionFileSystem.Name, FallbackValue=''}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding ImportFileSystemFromMediaCommand}" IsVisible="{Binding CanImportFileSystem}"
                ToolTip.Tip="Import file system with DOS type of partition from media like lha, adf or iso">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-file-import" />
            <TextBlock Text="Import from media" />
          </StackPanel>
        </Button>
        <Button Command="{Binding AddFileSystemFromFileCommand}" IsVisible="{Binding CanImportFileSystem}"
                ToolTip.Tip="Add file system with DOS type of partition from a file system file">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-file" />
            <TextBlock Text="Add from file" />
          </StackPanel>
        </Button>
        <Button Command="{Binding RemoveImportedFileSystemCommand}" IsVisible="{Binding IsImportedFileSystemSelected}"
                ToolTip.Tip="Remove file system imported for partition">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-trash" />
            <TextBlock Text="Remove file system" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Rigid disk block partition properties stored in partition block -->
    <StackPanel Spacing="8" IsVisible="{Binding IsRdb}">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox Content="Bootable"
                  IsChecked="{Binding SelectedPartition.Bootable, FallbackValue=False}"
                  IsEnabled="{Binding SelectedPartition.CanEditRdbProperties, FallbackValue=False}" />
        <CheckBox Content="No mount"
                  ToolTip.Tip="Partition is not mounted on boot"
                  IsChecked="{Binding SelectedPartition.NoMount, FallbackValue=False}"
                  IsEnabled="{Binding SelectedPartition.CanEditRdbProperties, FallbackValue=False}" />
      </StackPanel>

      <controls:ResponsiveColumns MaxColumns="4" MinColumnWidth="150">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-arrow-up-1-9" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Boot priority" />
          </StackPanel>
          <TextBox ToolTip.Tip="Boot priority of bootable partition from -128 to 127. Highest priority boots first"
                   Text="{Binding SelectedPartition.BootPriority, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding SelectedPartition.CanEditRdbProperties, FallbackValue=False}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-layer-group" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Buffers" />
          </StackPanel>
          <TextBox ToolTip.Tip="Number of buffers used by file system"
                   Text="{Binding SelectedPartition.Buffers, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding SelectedPartition.CanEditRdbProperties, FallbackValue=False}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-right-left" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Max transfer" />
          </StackPanel>
          <TextBox ToolTip.Tip="Max bytes transferred at a time as hex value, e.g. 0x1FE00, or number"
                   Text="{Binding SelectedPartition.MaxTransfer, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding SelectedPartition.CanEditRdbProperties, FallbackValue=False}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-memory" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Mask" />
          </StackPanel>
          <TextBox ToolTip.Tip="Address mask of memory to transfer to as hex value, e.g. 0x7FFFFFFE, or number"
                   Text="{Binding SelectedPartition.Mask, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding SelectedPartition.CanEditRdbProperties, FallbackValue=False}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-cube" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Block size" />
          </StackPanel>
          <ComboBox ItemsSource="{x:Static vm:PartitionEntryViewModel.FileSystemBlockSizes}"
                    SelectedItem="{Binding SelectedPartition.FileSystemBlockSize, FallbackValue={x:Null}}"
                    IsEnabled="{Binding SelectedPartition.CanEditRdbFileSystemProperties, FallbackValue=False}"
                    ToolTip.Tip="Block size of file system in bytes"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-backward-step" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Reserved" />
          </StackPanel>
          <TextBox ToolTip.Tip="Blocks reserved at start of partition"
                   Text="{Binding SelectedPartition.Reserved, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding SelectedPartition.CanEditRdbFileSystemProperties, FallbackValue=False}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-forward-step" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Pre alloc" />
          </StackPanel>
          <TextBox ToolTip.Tip="Blocks reserved at end of partition"
                   Text="{Binding SelectedPartition.PreAlloc, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding SelectedPartition.CanEditRdbFileSystemProperties, FallbackValue=False}" />
        </StackPanel>
      </controls:ResponsiveColumns>

      <TextBlock Classes="field-help" TextWrapping="Wrap"
                 IsVisible="{Binding !SelectedPartition.CanEditRdbFileSystemProperties, FallbackValue=False}"
                 Text="Block size, reserved and pre alloc can only be changed, when partition is formatted." />

      <TextBlock Classes="error-text" TextWrapping="Wrap"
                 IsVisible="{Binding SelectedPartition.HasRdbPropertiesError, FallbackValue=False}"
                 Text="{Binding SelectedPartition.RdbPropertiesError, FallbackValue=''}" />
    </StackPanel>
    <CheckBox Content="Active (bootable)" IsVisible="{Binding IsMbr}"
              IsChecked="{Binding SelectedPartition.Bootable, FallbackValue=False}"
              IsEnabled="{Binding SelectedPartition.CanEditActive, FallbackValue=False}" />

    <!-- Size of new partition -->
    <StackPanel Spacing="4" IsVisible="{Binding IsNewPartitionSelected}">
      <Grid ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,0,4">
          <ia:Icon Value="fa-arrow-left" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Free space preceding" />
        </StackPanel>
        <TextBox Grid.Row="1" Grid.Column="0" Classes="commit-on-enter"
                 Text="{Binding EditorFreeSpacePreceding, UpdateSourceTrigger=LostFocus}" />

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,4">
          <ia:Icon Value="fa-ruler-horizontal" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Size" />
        </StackPanel>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Classes="commit-on-enter"
                 Text="{Binding EditorSize, UpdateSourceTrigger=LostFocus}" />

        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="8,0,0,4">
          <ia:Icon Value="fa-arrow-right" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Free space following" />
        </StackPanel>
        <TextBox Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Classes="commit-on-enter"
                 Text="{Binding EditorFreeSpaceFollowing, UpdateSourceTrigger=LostFocus}" />

        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Spacing="5" Margin="8,0,0,4">
          <ia:Icon Value="fa-scale-balanced" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Unit" />
        </StackPanel>
        <ComboBox Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" MinWidth="90"
                  ItemsSource="{x:Static vm:PartitionViewModel.SizeUnits}"
                  SelectedItem="{Binding SizeUnit}" />
      </Grid>
      <TextBlock Classes="field-help" TextWrapping="Wrap"
                 Text="{Binding EditorMaxSizeText, StringFormat='{}{0} Press enter or leave field to update size.'}" />
    </StackPanel>

    <TextBlock Classes="field-help" TextWrapping="Wrap"
               Text="{Binding PartitionDialogHelpText}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" MinWidth="80" HorizontalContentAlignment="Center" Content="Cancel" />
      <Button x:Name="OkButton" MinWidth="80" HorizontalContentAlignment="Center" Content="{Binding PartitionDialogOkText}" Classes="primary"
              IsEnabled="{Binding !SelectedPartition.HasError, FallbackValue=True}" />
    </StackPanel>
  </StackPanel>
</Window>

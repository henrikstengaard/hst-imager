<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             xmlns:views="using:Hst.Imager.AvaloniaApp.Views"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:controls="using:Hst.Imager.AvaloniaApp.Controls"
             x:Class="Hst.Imager.AvaloniaApp.Views.CompareView"
             x:DataType="vm:CompareViewModel">

  <controls:PageLayout Title="Compare"
                       Description="Compare image files and physical disks byte by byte.">
    <StackPanel Spacing="8">
      <views:ElevationBanner />

      <Border Background="{DynamicResource AppErrorBackgroundBrush}" CornerRadius="4" Padding="8" IsVisible="{Binding HasError}">
        <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <!-- Source -->
      <StackPanel Orientation="Horizontal" Spacing="5">
        <ia:Icon Value="fa-upload" Classes="field-icon" />
        <TextBlock Classes="field-label" Text="Source" />
      </StackPanel>
      <ComboBox ItemsSource="{Binding SourceTypeOptions}"
                SelectedItem="{Binding SourceType}"
                DisplayMemberBinding="{Binding Title}"
                HorizontalAlignment="Stretch" />

      <!-- Source: image file -->
      <StackPanel Spacing="4" IsVisible="{Binding SourceIsImageFile}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-file" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Source image file" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SourcePath}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}" ToolTip.Tip="Browse">
            <ia:Icon Value="fa-folder-open" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Source: physical disk -->
      <StackPanel Spacing="4" IsVisible="{Binding SourceIsPhysicalDisk}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-hdd" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Source physical disk" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <views:ElevationWarningIcon Grid.Column="0" Margin="0,0,8,0" />
          <Panel Grid.Column="1">
            <ComboBox IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsElevated, FallbackValue=False}"
                      ItemsSource="{Binding MediaItems}"
                      SelectedItem="{Binding SourceDisk}"
                      DisplayMemberBinding="{Binding Label}"
                      HorizontalAlignment="Stretch" />
            <!-- loading indicator shown while getting physical disks -->
            <ia:Icon Value="fa-spinner" Animation="Spin"
                     IsVisible="{Binding IsLoadingMedia}" IsHitTestVisible="False"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0" />
          </Panel>
          <Button Grid.Column="2" Margin="8,0,0,0"
                  IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsElevated, FallbackValue=False}"
                  Command="{Binding RefreshMediaCommand}" ToolTip.Tip="Refresh">
            <ia:Icon Value="fa-sync-alt" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Destination -->
      <StackPanel Orientation="Horizontal" Spacing="5">
        <ia:Icon Value="fa-download" Classes="field-icon" />
        <TextBlock Classes="field-label" Text="Destination" />
      </StackPanel>
      <ComboBox ItemsSource="{Binding SourceTypeOptions}"
                SelectedItem="{Binding DestType}"
                DisplayMemberBinding="{Binding Title}"
                HorizontalAlignment="Stretch" />

      <!-- Destination: image file -->
      <StackPanel Spacing="4" IsVisible="{Binding DestIsImageFile}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-file" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Destination image file" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding DestinationPath}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseDestinationCommand}" ToolTip.Tip="Browse">
            <ia:Icon Value="fa-folder-open" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Destination: physical disk -->
      <StackPanel Spacing="4" IsVisible="{Binding DestIsPhysicalDisk}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-hdd" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Destination physical disk" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <views:ElevationWarningIcon Grid.Column="0" Margin="0,0,8,0" />
          <Panel Grid.Column="1">
            <ComboBox IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsElevated, FallbackValue=False}"
                      ItemsSource="{Binding MediaItems}"
                      SelectedItem="{Binding DestDisk}"
                      DisplayMemberBinding="{Binding Label}"
                      HorizontalAlignment="Stretch" />
            <!-- loading indicator shown while getting physical disks -->
            <ia:Icon Value="fa-spinner" Animation="Spin"
                     IsVisible="{Binding IsLoadingMedia}" IsHitTestVisible="False"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0" />
          </Panel>
          <Button Grid.Column="2" Margin="8,0,0,0"
                  IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsElevated, FallbackValue=False}"
                  Command="{Binding RefreshMediaCommand}" ToolTip.Tip="Refresh">
            <ia:Icon Value="fa-sync-alt" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Advanced -->
      <Expander IsExpanded="False" HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-gear" />
            <TextBlock Text="Advanced" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="8" Margin="0,8">

          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-chart-pie" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="{Binding SrcPartPathLabel}" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding SrcPartPath.Options}"
                    SelectedItem="{Binding SrcPartPath.Selected}"
                    DisplayMemberBinding="{Binding Title}"
                    PlaceholderText="None available"
                    IsEnabled="{Binding HasSourceMedia}"
                    HorizontalAlignment="Stretch" />

          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-location-crosshairs" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Source start offset" />
          </StackPanel>
          <NumericUpDown Value="{Binding SrcPartPath.StartOffset}" Minimum="0" Increment="512" FormatString="0"
                         IsEnabled="{Binding SrcPartPath.IsCustom}" />

          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-chart-pie" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="{Binding DestPartPathLabel}" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding DestPartPath.Options}"
                    SelectedItem="{Binding DestPartPath.Selected}"
                    DisplayMemberBinding="{Binding Title}"
                    PlaceholderText="None available"
                    IsEnabled="{Binding HasDestinationMedia}"
                    HorizontalAlignment="Stretch" />

          <StackPanel Orientation="Horizontal" Spacing="5">
            <ia:Icon Value="fa-location-crosshairs" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Destination start offset" />
          </StackPanel>
          <NumericUpDown Value="{Binding DestPartPath.StartOffset}" Minimum="0" Increment="512" FormatString="0"
                         IsEnabled="{Binding DestPartPath.IsCustom}" />

          <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,0,4">
              <ia:Icon Value="fa-ruler-horizontal" Classes="field-icon" />
              <TextBlock Classes="field-label" Text="Size" />
            </StackPanel>
            <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding Size}" Minimum="0" Increment="1"
                           IsEnabled="{Binding IsSizeEnabled}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,4">
              <ia:Icon Value="fa-scale-balanced" Classes="field-icon" />
              <TextBlock Classes="field-label" Text="Unit" />
            </StackPanel>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Static vm:CompareViewModel.SizeUnits}"
                      SelectedItem="{Binding SizeUnit}"
                      IsEnabled="{Binding IsSizeEnabled}" />
          </Grid>

          <CheckBox Content="Byteswap source sectors" IsChecked="{Binding Byteswap}" />

        </StackPanel>
      </Expander>
    </StackPanel>

    <controls:PageLayout.Actions>
      <DockPanel>
        <Button DockPanel.Dock="Left" Command="{Binding BackCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-arrow-left" />
            <TextBlock Text="Back" />
          </StackPanel>
        </Button>
        <Button HorizontalAlignment="Right" Command="{Binding StartCompareCommand}" Classes="primary">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-check" />
            <TextBlock Text="Start compare" />
          </StackPanel>
        </Button>
      </DockPanel>
    </controls:PageLayout.Actions>
  </controls:PageLayout>
</UserControl>

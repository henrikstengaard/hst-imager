<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             x:Class="Hst.Imager.AvaloniaApp.Views.CompareView"
             x:DataType="vm:CompareViewModel">

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="12" Margin="0,8">
        <TextBlock Classes="page-title" Text="Compare" />
        <TextBlock Classes="page-description"
                   Text="Compare image files and physical disks byte by byte." />

        <Border Background="#4A1A1A" CornerRadius="4" Padding="8" IsVisible="{Binding HasError}">
          <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Source type -->
        <TextBlock Text="Source type" Foreground="#AAAAAA" FontSize="12" />
        <ComboBox ItemsSource="{x:Static vm:CompareViewModel.MediaTypes}"
                  SelectedItem="{Binding SourceType}"
                  HorizontalAlignment="Stretch" />

        <!-- Source: image file -->
        <StackPanel IsVisible="{Binding SourceIsImageFile}">
          <TextBlock Text="Source image file" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding SourcePath}" Watermark="Path to source image file..." />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}">...</Button>
          </Grid>
        </StackPanel>

        <!-- Source: physical disk -->
        <StackPanel IsVisible="{Binding !SourceIsImageFile}">
          <TextBlock Text="Source physical disk" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding MediaItems}"
                      SelectedItem="{Binding SourceMedia}"
                      DisplayMemberBinding="{Binding Label}"
                      HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshMediaCommand}">&#8635;</Button>
          </Grid>
        </StackPanel>

        <!-- Destination type -->
        <TextBlock Text="Destination type" Foreground="#AAAAAA" FontSize="12" />
        <ComboBox ItemsSource="{x:Static vm:CompareViewModel.MediaTypes}"
                  SelectedItem="{Binding DestType}"
                  HorizontalAlignment="Stretch" />

        <!-- Destination: image file -->
        <StackPanel IsVisible="{Binding DestIsImageFile}">
          <TextBlock Text="Destination image file" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding DestinationPath}"
                     Watermark="Path to destination image file..." />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseDestinationCommand}">...</Button>
          </Grid>
        </StackPanel>

        <!-- Destination: physical disk -->
        <StackPanel IsVisible="{Binding !DestIsImageFile}">
          <TextBlock Text="Destination physical disk" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding MediaItems}"
                      SelectedItem="{Binding DestMedia}"
                      DisplayMemberBinding="{Binding Label}"
                      HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshMediaCommand}">&#8635;</Button>
          </Grid>
        </StackPanel>

        <!-- Advanced options -->
        <Expander Header="Advanced" IsExpanded="False">
          <StackPanel Spacing="8" Margin="0,8">

            <TextBlock Text="Source start offset (bytes)" Foreground="#AAAAAA" FontSize="12" />
            <NumericUpDown Value="{Binding SourceStartOffset}" Minimum="0" Increment="512" />

            <TextBlock Text="Destination start offset (bytes)" Foreground="#AAAAAA" FontSize="12" />
            <NumericUpDown Value="{Binding DestinationStartOffset}" Minimum="0" Increment="512" />

            <TextBlock Text="Size (0 = full)" Foreground="#AAAAAA" FontSize="12" />
            <Grid ColumnDefinitions="*,Auto">
              <NumericUpDown Grid.Column="0" Value="{Binding Size}" Minimum="0" Increment="1" />
              <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="80"
                        ItemsSource="{x:Static vm:CompareViewModel.SizeUnits}"
                        SelectedItem="{Binding SizeUnit}" />
            </Grid>

            <CheckBox Content="Byteswap source sectors" IsChecked="{Binding Byteswap}" />

          </StackPanel>
        </Expander>

        <Border IsVisible="{Binding Progress.IsRunning}" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Progress.Title}" Foreground="White" FontWeight="SemiBold" />
            <ProgressBar Value="{Binding Progress.PercentComplete}" Minimum="0" Maximum="100" Height="8" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{Binding Progress.BytesText}" Foreground="#AAAAAA" FontSize="12" />
              <TextBlock Text="{Binding Progress.SpeedText}" Foreground="#AAAAAA" FontSize="12" />
              <TextBlock Text="{Binding Progress.EtaText}" Foreground="#AAAAAA" FontSize="12" />
            </StackPanel>
            <TextBlock Classes="error-text" Text="{Binding Progress.ErrorMessage}"
                       IsVisible="{Binding Progress.HasError}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Command="{Binding CancelCommand}" IsVisible="{Binding Progress.IsRunning}">Cancel</Button>
      <Button Command="{Binding StartCompareCommand}"
              IsVisible="{Binding !Progress.IsRunning}"
              Classes="accent">Start Compare</Button>
    </StackPanel>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             xmlns:views="using:Hst.Imager.AvaloniaApp.Views"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:controls="using:Hst.Imager.AvaloniaApp.Controls"
             x:Class="Hst.Imager.AvaloniaApp.Views.WriteView"
             x:DataType="vm:WriteViewModel">

  <controls:PageLayout Title="Write"
                       Description="Write an image file or part of to a physical disk.">
    <!-- Source and destination side by side, when there is room for it -->
    <controls:ResponsiveColumns>
      <views:MediaSelectionCard DataContext="{Binding Source}" />
      <views:MediaSelectionCard DataContext="{Binding Destination}" />
    </controls:ResponsiveColumns>

    <controls:PageLayout.Actions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Command="{Binding ResetCommand}" ToolTip.Tip="Reset to defaults">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-rotate-left" />
            <TextBlock Text="Reset" />
          </StackPanel>
        </Button>
        <Button Command="{Binding StartWriteCommand}" Classes="danger">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-file-export" />
            <TextBlock Text="Start write" />
          </StackPanel>
        </Button>
      </StackPanel>
    </controls:PageLayout.Actions>
  </controls:PageLayout>
</UserControl>

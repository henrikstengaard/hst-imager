<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             xmlns:views="using:Hst.Imager.AvaloniaApp.Views"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:controls="using:Hst.Imager.AvaloniaApp.Controls"
             x:Class="Hst.Imager.AvaloniaApp.Views.InfoView"
             x:DataType="vm:InfoViewModel">

  <controls:PageLayout Title="Info"
                       Description="Display information about an image file or a physical disk.">
    <StackPanel Spacing="12">

      <StackPanel Spacing="8">
        <Border Background="{DynamicResource AppErrorBackgroundBrush}" CornerRadius="4" Padding="8"
                IsVisible="{Binding HasError}">
          <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <views:MediaSelectionCard DataContext="{Binding Source}" />
      </StackPanel>

      <!-- Loading indicator -->
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4" />

      <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasDiskInfo}">
        <TextBlock Classes="section-title" Margin="0" Text="{Binding SourceTypeFormatted, StringFormat='Source {0}'}" />
        <TextBlock Foreground="{DynamicResource AppBodyForegroundBrush}" Text="{Binding SourceTypeFormatted, StringFormat='Disk information read from source {0}.'}" />
      </StackPanel>

      <!-- Tabbed disk info -->
      <TabControl IsVisible="{Binding HasDiskInfo}">

        <!-- Overview tab -->
        <TabItem Header="Overview">
          <StackPanel Spacing="8" Margin="0,8">
            <CheckBox Content="Show unallocated" IsChecked="{Binding ShowUnallocated}" />

            <ItemsControl ItemsSource="{Binding OverviewSections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:OverviewSectionViewModel">
                  <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                    <DataGrid ItemsSource="{Binding Parts}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                              GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="140" />
                        <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" Width="100" />
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
                        <DataGridTextColumn Header="Start offset" Binding="{Binding StartOffset}" Width="90" />
                        <DataGridTextColumn Header="End offset" Binding="{Binding EndOffset}" Width="90" />
                        <DataGridTextColumn Header="Start" Binding="{Binding StartSecOrCyl}" Width="80" />
                        <DataGridTextColumn Header="End" Binding="{Binding EndSecOrCyl}" Width="80" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>

        <!-- Details tab -->
        <TabItem Header="Details">
          <StackPanel Spacing="8" Margin="0,8">
            <CheckBox Content="Show human readable sizes" IsChecked="{Binding ShowHumanReadable}" />

            <ItemsControl ItemsSource="{Binding DetailSections}" x:CompileBindings="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ContentControl Content="{Binding}">
                    <ContentControl.DataTemplates>

                      <DataTemplate DataType="vm:DiskInfoDetailSection">
                        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                          <DataGrid ItemsSource="{Binding Rows}"
                                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                                    GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Expander>
                      </DataTemplate>

                      <DataTemplate DataType="vm:GeometryDetailSection">
                        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                          <DataGrid ItemsSource="{Binding Rows}"
                                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                                    GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Expander>
                      </DataTemplate>

                      <DataTemplate DataType="vm:MbrPartitionsDetailSection">
                        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                          <DataGrid ItemsSource="{Binding Rows}"
                                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                                    GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Number" Binding="{Binding Number}" />
                              <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                              <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                              <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" />
                              <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                              <DataGridTextColumn Header="Start sector" Binding="{Binding StartSector}" />
                              <DataGridTextColumn Header="End sector" Binding="{Binding EndSector}" />
                              <DataGridTextColumn Header="Active" Binding="{Binding Active}" />
                              <DataGridTextColumn Header="Primary" Binding="{Binding Primary}" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Expander>
                      </DataTemplate>

                      <DataTemplate DataType="vm:GptPartitionsDetailSection">
                        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                          <DataGrid ItemsSource="{Binding Rows}"
                                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                                    GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Number" Binding="{Binding Number}" />
                              <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" />
                              <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                              <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" />
                              <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                              <DataGridTextColumn Header="Start sector" Binding="{Binding StartSector}" />
                              <DataGridTextColumn Header="End sector" Binding="{Binding EndSector}" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Expander>
                      </DataTemplate>

                      <DataTemplate DataType="vm:RdbInfoDetailSection">
                        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                          <DataGrid ItemsSource="{Binding Rows}"
                                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                                    GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Expander>
                      </DataTemplate>

                      <DataTemplate DataType="vm:RdbFileSystemsDetailSection">
                        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                          <DataGrid ItemsSource="{Binding Rows}"
                                    IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                                    GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Number" Binding="{Binding Number}" />
                              <DataGridTextColumn Header="DOS type" Binding="{Binding DosType}" />
                              <DataGridTextColumn Header="Version" Binding="{Binding Version}" />
                              <DataGridTextColumn Header="File system name" Binding="{Binding FileSystemName}" />
                              <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Expander>
                      </DataTemplate>

                      <DataTemplate DataType="vm:RdbPartitionsDetailSection">
                        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,4">
                          <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <DataGrid ItemsSource="{Binding Rows}"
                                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                                      GridLinesVisibility="All" Background="{DynamicResource AppPanelBackgroundBrush}" Margin="0,4">
                              <DataGrid.Columns>
                                <DataGridTextColumn Header="Number" Binding="{Binding Number}" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                                <DataGridTextColumn Header="Start cyl" Binding="{Binding StartCyl}" />
                                <DataGridTextColumn Header="End cyl" Binding="{Binding EndCyl}" />
                                <DataGridTextColumn Header="Total cyl" Binding="{Binding TotalCyl}" />
                                <DataGridTextColumn Header="Heads" Binding="{Binding Heads}" />
                                <DataGridTextColumn Header="Blks/track" Binding="{Binding BlocksPerTrack}" />
                                <DataGridTextColumn Header="Buffers" Binding="{Binding Buffers}" />
                                <DataGridTextColumn Header="FS block" Binding="{Binding FsBlockSize}" />
                                <DataGridTextColumn Header="Reserved" Binding="{Binding Reserved}" />
                                <DataGridTextColumn Header="PreAlloc" Binding="{Binding PreAlloc}" />
                                <DataGridTextColumn Header="Bootable" Binding="{Binding Bootable}" />
                                <DataGridTextColumn Header="Boot pri" Binding="{Binding BootPriority}" />
                                <DataGridTextColumn Header="No mount" Binding="{Binding NoMount}" />
                                <DataGridTextColumn Header="DOS type" Binding="{Binding DosType}" />
                                <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" />
                                <DataGridTextColumn Header="Max xfer" Binding="{Binding MaxTransfer}" />
                              </DataGrid.Columns>
                            </DataGrid>
                          </ScrollViewer>
                        </Expander>
                      </DataTemplate>

                    </ContentControl.DataTemplates>
                  </ContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>

      </TabControl>

    </StackPanel>

    <controls:PageLayout.Actions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Command="{Binding ResetCommand}" ToolTip.Tip="Reset to defaults">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-rotate-left" />
            <TextBlock Text="Reset" />
          </StackPanel>
        </Button>
        <Button Command="{Binding GetInfoCommand}" Classes="primary">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ia:Icon Value="fa-info" />
            <TextBlock Text="Get info" />
          </StackPanel>
        </Button>
      </StackPanel>
    </controls:PageLayout.Actions>
  </controls:PageLayout>
</UserControl>

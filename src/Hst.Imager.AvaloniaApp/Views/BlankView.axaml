<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             x:Class="Hst.Imager.AvaloniaApp.Views.BlankView"
             x:DataType="vm:BlankViewModel">

    <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,8" MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="Blank" />
        <TextBlock Classes="page-description" Text="Create a blank image file." />

        <Border Background="#4A1A1A" CornerRadius="4" Padding="8" IsVisible="{Binding HasError}">
          <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Image file -->
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-file" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Image file" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding OutputPath}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" ToolTip.Tip="Browse">
            <ia:Icon Value="fa-folder-open" />
          </Button>
        </Grid>

        <!-- Size and unit -->
        <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,0,4">
            <ia:Icon Value="fa-ruler-horizontal" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Size" />
          </StackPanel>
          <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding Size}" Minimum="0" Increment="1" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,4">
            <ia:Icon Value="fa-scale-balanced" Classes="field-icon" />
            <TextBlock Classes="field-label" Text="Unit" />
          </StackPanel>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Static vm:BlankViewModel.SizeUnits}"
                    SelectedItem="{Binding SizeUnit}" />
        </Grid>

        <CheckBox Content="Size compatible with various SD/CF-cards, SSD and hard-disk brands"
                  IsChecked="{Binding CompatibleSize}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
          <Button Command="{Binding CancelCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ia:Icon Value="fa-ban" />
              <TextBlock Text="Cancel" />
            </StackPanel>
          </Button>
          <Button Command="{Binding StartBlankCommand}" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ia:Icon Value="fa-plus" />
              <TextBlock Text="Create blank image" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
</UserControl>

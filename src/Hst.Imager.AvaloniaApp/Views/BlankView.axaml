<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             x:Class="Hst.Imager.AvaloniaApp.Views.BlankView"
             x:DataType="vm:BlankViewModel">

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="12" Margin="0,8">
        <TextBlock Classes="page-title" Text="Blank" />
        <TextBlock Classes="page-description" Text="Creates a blank image file of a specified size." />

        <Border Background="#4A1A1A" CornerRadius="4" Padding="8" IsVisible="{Binding HasError}">
          <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Output image file" Foreground="#AAAAAA" FontSize="12" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding OutputPath}" Watermark="Path to output image file..." />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}">...</Button>
        </Grid>

        <TextBlock Text="Size (bytes)" Foreground="#AAAAAA" FontSize="12" />
        <NumericUpDown Value="{Binding Size}" Minimum="512" Increment="1048576" />

        <CheckBox Content="Compatible size (rounds to nearest MB)" IsChecked="{Binding CompatibleSize}" />

        <Border IsVisible="{Binding Progress.IsRunning}" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Progress.Title}" Foreground="White" FontWeight="SemiBold" />
            <ProgressBar Value="{Binding Progress.PercentComplete}" Minimum="0" Maximum="100" Height="8" />
            <TextBlock Classes="error-text" Text="{Binding Progress.ErrorMessage}" IsVisible="{Binding Progress.HasError}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Command="{Binding CancelCommand}" IsVisible="{Binding Progress.IsRunning}">Cancel</Button>
      <Button Command="{Binding StartBlankCommand}" IsVisible="{Binding !Progress.IsRunning}" Classes="accent">Create Blank Image</Button>
    </StackPanel>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             x:Class="Hst.Imager.AvaloniaApp.Views.TransferView"
             x:DataType="vm:TransferViewModel">

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="12" Margin="0,8">
        <TextBlock Classes="page-title" Text="Transfer" />
        <TextBlock Classes="page-description" Text="Transfer data between two physical disks or image files." />

        <Border Background="#4A1A1A" CornerRadius="4" Padding="8" IsVisible="{Binding HasError}">
          <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Source disk" Foreground="#AAAAAA" FontSize="12" />
        <Grid ColumnDefinitions="*,Auto">
          <ComboBox Grid.Column="0" ItemsSource="{Binding SourceMediaItems}" SelectedItem="{Binding SourceMedia}"
                    DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshMediaCommand}">&#8635;</Button>
        </Grid>

        <TextBlock Text="Destination disk" Foreground="#AAAAAA" FontSize="12" />
        <ComboBox ItemsSource="{Binding DestMediaItems}" SelectedItem="{Binding DestMedia}"
                  DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch" />

        <Expander Header="Advanced options" IsExpanded="False">
          <StackPanel Spacing="8" Margin="0,8">
            <TextBlock Text="Source start offset (bytes)" Foreground="#AAAAAA" FontSize="12" />
            <NumericUpDown Value="{Binding SrcStartOffset}" Minimum="0" Increment="512" />
            <TextBlock Text="Destination start offset (bytes)" Foreground="#AAAAAA" FontSize="12" />
            <NumericUpDown Value="{Binding DestStartOffset}" Minimum="0" Increment="512" />
            <TextBlock Text="Size (bytes, 0 = full)" Foreground="#AAAAAA" FontSize="12" />
            <NumericUpDown Value="{Binding Size}" Minimum="0" Increment="1048576" />
            <CheckBox Content="Byteswap source sectors" IsChecked="{Binding Byteswap}" />
          </StackPanel>
        </Expander>

        <Border IsVisible="{Binding Progress.IsRunning}" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Progress.Title}" Foreground="White" FontWeight="SemiBold" />
            <ProgressBar Value="{Binding Progress.PercentComplete}" Minimum="0" Maximum="100" Height="8" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{Binding Progress.BytesText}" Foreground="#AAAAAA" FontSize="12" />
              <TextBlock Text="{Binding Progress.SpeedText}" Foreground="#AAAAAA" FontSize="12" />
              <TextBlock Text="{Binding Progress.EtaText}" Foreground="#AAAAAA" FontSize="12" />
            </StackPanel>
            <TextBlock Classes="error-text" Text="{Binding Progress.ErrorMessage}" IsVisible="{Binding Progress.HasError}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Command="{Binding CancelCommand}" IsVisible="{Binding Progress.IsRunning}">Cancel</Button>
      <Button Command="{Binding StartTransferCommand}" IsVisible="{Binding !Progress.IsRunning}" Classes="accent">Start Transfer</Button>
    </StackPanel>
  </Grid>
</UserControl>

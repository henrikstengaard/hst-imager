<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             x:Class="Hst.Imager.AvaloniaApp.Views.TransferView"
             x:DataType="vm:TransferViewModel">

    <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,8" MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="Transfer" />
        <TextBlock Classes="page-description"
                   Text="Transfer converts, imports or exports from an image file or part of to another." />

        <Border Background="{DynamicResource AppErrorBackgroundBrush}" CornerRadius="4" Padding="8" IsVisible="{Binding HasError}">
          <TextBlock Classes="error-text" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Source image file -->
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-upload" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Source image file" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SourcePath}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}" ToolTip.Tip="Browse">
            <ia:Icon Value="fa-folder-open" />
          </Button>
        </Grid>

        <!-- Destination image file -->
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ia:Icon Value="fa-download" Classes="field-icon" />
          <TextBlock Classes="field-label" Text="Destination image file" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding DestinationPath}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseDestinationCommand}" ToolTip.Tip="Browse">
            <ia:Icon Value="fa-folder-open" />
          </Button>
        </Grid>

        <!-- Advanced -->
        <Expander IsExpanded="False" HorizontalAlignment="Stretch">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ia:Icon Value="fa-gear" />
              <TextBlock Text="Advanced" />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="8" Margin="0,8">

            <StackPanel Orientation="Horizontal" Spacing="5">
              <ia:Icon Value="fa-chart-pie" Classes="field-icon" />
              <TextBlock Classes="field-label" Text="Part of source image file to read from" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding SrcPartPath.Options}"
                      SelectedItem="{Binding SrcPartPath.Selected}"
                      DisplayMemberBinding="{Binding Title}"
                      PlaceholderText="None available"
                      IsEnabled="{Binding HasSourceMedia}"
                      HorizontalAlignment="Stretch" />

            <StackPanel Orientation="Horizontal" Spacing="5">
              <ia:Icon Value="fa-location-crosshairs" Classes="field-icon" />
              <TextBlock Classes="field-label" Text="Source start offset" />
            </StackPanel>
            <NumericUpDown Value="{Binding SrcPartPath.StartOffset}" Minimum="0" Increment="512" FormatString="0"
                           IsEnabled="{Binding SrcPartPath.IsCustom}" />

            <StackPanel Orientation="Horizontal" Spacing="5">
              <ia:Icon Value="fa-chart-pie" Classes="field-icon" />
              <TextBlock Classes="field-label" Text="Part of destination image file to write to" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding DestPartPath.Options}"
                      SelectedItem="{Binding DestPartPath.Selected}"
                      DisplayMemberBinding="{Binding Title}"
                      PlaceholderText="None available"
                      IsEnabled="{Binding HasDestinationMedia}"
                      HorizontalAlignment="Stretch" />

            <StackPanel Orientation="Horizontal" Spacing="5">
              <ia:Icon Value="fa-location-crosshairs" Classes="field-icon" />
              <TextBlock Classes="field-label" Text="Destination start offset" />
            </StackPanel>
            <NumericUpDown Value="{Binding DestPartPath.StartOffset}" Minimum="0" Increment="512" FormatString="0"
                           IsEnabled="{Binding DestPartPath.IsCustom}" />

            <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,0,4">
                <ia:Icon Value="fa-ruler-horizontal" Classes="field-icon" />
                <TextBlock Classes="field-label" Text="Size" />
              </StackPanel>
              <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding Size}" Minimum="0" Increment="1"
                             IsEnabled="{Binding IsSizeEnabled}" />
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,4">
                <ia:Icon Value="fa-scale-balanced" Classes="field-icon" />
                <TextBlock Classes="field-label" Text="Unit" />
              </StackPanel>
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Static vm:TransferViewModel.SizeUnits}"
                        SelectedItem="{Binding SizeUnit}"
                        IsEnabled="{Binding IsSizeEnabled}" />
            </Grid>

            <CheckBox Content="Byteswap source sectors" IsChecked="{Binding Byteswap}" />

          </StackPanel>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
          <Button Command="{Binding CancelCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ia:Icon Value="fa-ban" />
              <TextBlock Text="Cancel" />
            </StackPanel>
          </Button>
          <Button Command="{Binding StartTransferCommand}" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ia:Icon Value="fa-exchange-alt" />
              <TextBlock Text="Start transfer" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
</UserControl>

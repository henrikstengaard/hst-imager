<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hst.Imager.AvaloniaApp.ViewModels"
             xmlns:ia="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             x:Class="Hst.Imager.AvaloniaApp.Views.ProgressOverlay"
             x:DataType="vm:ProgressViewModel">

  <!-- Modal overlay blocking the app while a task runs, like gui app progress backdrop -->
  <Border Background="#B3000000" IsVisible="{Binding IsVisible}">
    <Border Classes="card" Width="560" Padding="20"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">

        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="White"
                   TextWrapping="Wrap" TextAlignment="Center" />

        <!-- Running -->
        <StackPanel Spacing="8" IsVisible="{Binding IsRunning}">
          <ProgressBar Value="{Binding PercentComplete}" Minimum="0" Maximum="100" Height="8" />
          <TextBlock Text="{Binding PercentText}" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding BytesText}" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="{Binding SpeedText}" Foreground="#AAAAAA" FontSize="12" />
            <TextBlock Text="{Binding EtaText}" Foreground="#AAAAAA" FontSize="12" />
          </StackPanel>
          <Button Command="{Binding CancelCommand}" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ia:Icon Value="fa-ban" />
              <TextBlock Text="Cancel" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Completed -->
        <StackPanel Spacing="12" IsVisible="{Binding IsComplete}">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                      IsVisible="{Binding IsSuccess}">
            <ia:Icon Value="fa-check" Foreground="#33CC33" />
            <TextBlock Text="Completed successfully" Foreground="#33CC33" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                      IsVisible="{Binding HasError}">
            <ia:Icon Value="fa-times" Foreground="#CC3333" VerticalAlignment="Top" />
            <TextBlock Foreground="#CC3333" TextWrapping="Wrap" MaxWidth="480"
                       Text="{Binding ErrorMessage, StringFormat='Failed: {0}'}" />
          </StackPanel>
          <Button Command="{Binding OkCommand}" Classes="accent" HorizontalAlignment="Center" MinWidth="80"
                  HorizontalContentAlignment="Center">Ok</Button>
        </StackPanel>

      </StackPanel>
    </Border>
  </Border>
</UserControl>
